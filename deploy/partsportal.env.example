# Copy to /etc/partsportal/partsportal-api.env on the VM.
# This file is sourced by /etc/init.d/partsportal-api, so keep values shell-safe.
# Do not commit the real database password.

export ASPNETCORE_ENVIRONMENT='Production'
export ASPNETCORE_URLS='http://127.0.0.1:5085'
export ConnectionStrings__PartsPortalDb='Server=127.0.0.1;Port=3306;Database=partsportal;User=partsportal_app;Password=CHANGE_ME'

# Release metadata retained for the download page / future policy features.
# ClickOnce itself owns client update detection.
export ClientVersion__LatestVersion='3.2.9'
export ClientVersion__MinimumSupportedVersion='3.2.8'
export ClientVersion__DownloadUrl='http://10.130.206.135/partsportal/install/PartsPortal.application'
export ClientVersion__ReleaseNotes__0='ClickOnce deployment foundation.'
