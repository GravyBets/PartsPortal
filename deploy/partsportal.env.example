# Copy to /etc/partsportal/partsportal-api.env on the VM.
# This file is sourced by /etc/init.d/partsportal-api, so keep values shell-safe.
# Do not commit the real database password.

export ASPNETCORE_ENVIRONMENT='Production'
export ASPNETCORE_URLS='http://127.0.0.1:5085'
export ConnectionStrings__PartsPortalDb='Server=127.0.0.1;Port=3306;Database=partsportal;User=partsportal_app;Password=CHANGE_ME'

# Client release policy. These values can be changed for future client releases
# without rebuilding the API; restart partsportal-api after editing them.
export ClientVersion__LatestVersion='3.2.6'
export ClientVersion__MinimumSupportedVersion='3.2.5'
export ClientVersion__DownloadUrl='http://10.130.206.135/partsportal/install/PartsPortal-Setup-3.2.6.msi'
export ClientVersion__ReleaseNotes__0='Added automatic update notifications.'
export ClientVersion__ReleaseNotes__1='PartsPortal releases are now hosted on the internal server.'
export ClientVersion__ReleaseNotes__2='Improved installer upgrade handling.'
