<Window x:Class="MaterialReqAppV3.BackordersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backordered Parts"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Icon="Assets/MaterialReqAppIcon.ico">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Search + All Parts -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <TextBox x:Name="PartsSearchBox"
                     Height="34"
                     Margin="0,0,0,10"
                     Tag="Search parts..."
                     Style="{StaticResource ModernWatermarkTextBox}"
                     TextChanged="PartsSearchBox_TextChanged"/>

            <!-- All Parts list -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="10">

                <ListBox x:Name="AllPartsListBox"
                         Style="{StaticResource ThemedListBoxInTabsStyle}"
                         ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"
                         ItemTemplate="{StaticResource PartItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         MouseDoubleClick="AllPartsListBox_MouseDoubleClick"/>
            </Border>
        </Grid>

        <!-- RIGHT: Backorder cart -->
        <Border Grid.Column="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Backorder Cart"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Double-click a part on the left to add Qty, Work Order, and Site/Reason."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>                    
                </StackPanel>

                <DataGrid x:Name="BackorderGrid"
                          Grid.Row="1"
                          Margin="0,12,0,0"
                          Style="{StaticResource ThemedDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent"
                          MinRowHeight="46"
                          ColumnHeaderHeight="34"
                          FontSize="14"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"
                                            Width="95"
                                            Binding="{Binding DateAdded, StringFormat={}{0:MM/dd/yyyy}}"/>

                        <DataGridTextColumn Header="Qty"
                                            Width="50"
                                            Binding="{Binding Qty}"/>

                        <DataGridTextColumn Header="Work Order"
                                            Width="140"
                                            Binding="{Binding WorkOrder}"/>

                        <DataGridTextColumn Header="Site / Reason"
                                            Width="220"
                                            Binding="{Binding SiteReason}"/>

                        <DataGridTemplateColumn Header="Part" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Description}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Material}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>  
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button Content="Remove Selected"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="RemoveSelected_Click"/>

                    <!-- Placeholder for Step 3 -->
                    <Button x:Name="OrderPartsButton"
        Content="Order Selected"
        Style="{StaticResource PrimaryButtonStyle}"
        Click="OrderSelected_Click"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
