<Window x:Class="MaterialReqAppV3.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="360"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Employee ID:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="EmployeeIdBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Truck #:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="TruckBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="PDF Output Folder:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="PdfFolderBox" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10"/>
            <Button Grid.Row="3" Grid.Column="2" Content="Browse..." Padding="12,4" Margin="0,0,0,10"
                    Click="BrowsePdfFolder_Click"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Parts CSV Path:" VerticalAlignment="Center"/>
            <TextBox x:Name="CsvPathBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,0"/>
            <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Padding="12,4"
                    Click="BrowseCsv_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
