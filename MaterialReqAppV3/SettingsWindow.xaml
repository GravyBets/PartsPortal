<Window x:Class="MaterialReqAppV3.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="600"
        Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        Icon="Assets/MaterialReqAppIcon.ico">

    <Window.Resources>

        <!-- Labels -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBg}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Readonly variant (slightly muted) -->
        <Style x:Key="ModernTextBoxReadOnly" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header Card ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Update your info, paths, and email recipients."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- ===== Form Card ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Emp -->
                    <RowDefinition Height="Auto"/>
                    <!-- Truck -->
                    <RowDefinition Height="Auto"/>
                    <!-- Pdf -->
                    <RowDefinition Height="Auto"/>
                    <!-- Csv -->
                    <RowDefinition Height="Auto"/>
                    <!-- Divider -->
                    <RowDefinition Height="Auto"/>
                    <!-- Email To -->
                    <RowDefinition Height="Auto"/>
                    <!-- Email CC -->
                </Grid.RowDefinitions>

                <!-- Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Employee ID -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Employee ID:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBoxReadOnly}"
                         Margin="0,0,0,12"
                         Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Truck -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Truck #:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"
                         Text="{Binding TruckNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- PDF Output Folder -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="PDF Output Folder:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,10,12"
                         Text="{Binding PdfOutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="3" Grid.Column="2"
                        Content="Browse..."
                        Height="34"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowsePdfFolder_Click"/>

                <!-- Parts CSV Path -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Parts CSV Path:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,10,12"
                         Text="{Binding CsvPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="4" Grid.Column="2"
                        Content="Browse..."
                        Height="34"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseCsv_Click"/>

                <!-- Divider -->
                <Border Grid.Row="5" Grid.ColumnSpan="3"
                        Height="1"
                        Background="{DynamicResource CardBorder}"
                        Opacity="0.7"
                        Margin="0,6,0,16"/>

                <!-- Email To -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Email To:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"
                         Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Email CC -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Email CC:" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding EmailCc, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <!-- ===== Bottom Buttons ===== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Save"
                    Width="110"
                    Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
