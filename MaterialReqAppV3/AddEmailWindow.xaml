<Window x:Class="MaterialReqAppV3.AddEmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Directory Entry"
        Width="580"
        Height="388"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        Icon="Assets/MaterialReqAppIcon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header card -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Add Directory Entry"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Add a name + email for your shop directory."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- Body card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- First -->
                    <RowDefinition Height="Auto"/>
                    <!-- Last -->
                    <RowDefinition Height="Auto"/>
                    <!-- Email -->
                </Grid.RowDefinitions>

                <!-- First Name -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="First name:"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="FirstNameTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Height="34"
                         Margin="0,0,0,12"
                         MaxLength="40"
                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Last Name -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Last name:"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="LastNameTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Height="34"
                         Margin="0,0,0,12"
                         MaxLength="40"
                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Email -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Email:"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="EmailTextBox"
                         Grid.Row="2" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Height="34"
                         MaxLength="120"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Add"
                    Width="110"
                    Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
