<Window x:Class="PartsPortal.TemplateNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Template"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">

    <Window.Resources>       

    </Window.Resources>

    <Grid Margin="16">
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="2"
                CornerRadius="16"
                Padding="16"
                MinWidth="520">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- title -->
                    <RowDefinition Height="Auto"/>
                    <!-- label -->
                    <RowDefinition Height="Auto"/>
                    <!-- textbox -->
                    <RowDefinition Height="Auto"/>
                    <!-- buttons -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Save template"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1"
                           Text="Template name"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="NameBox"
                         Grid.Row="2"
                         Height="32"
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch"
                         Style="{StaticResource ModernWatermarkTextBox}"
                         Tag="e.g., AMS Enclosure Job"
                         Background="{DynamicResource SurfaceBg}"
                         BorderBrush="{DynamicResource SurfaceBorder}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button x:Name="OkBtn"
                            Content="Save"
                            IsDefault="True"
                            Click="Ok_Click"
                            
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
