<Window x:Class="MaterialReqAppV3.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="400" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="18">
        <Border CornerRadius="18"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Text="Material Requisition"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <!-- Version -->
                <TextBlock x:Name="VersionText"
                           Grid.Row="1"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>

                <!-- Body -->
                <StackPanel Grid.Row="2" Margin="0,40,0,0">

                    <!-- Developed by row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Developed by"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontWeight="SemiBold"/>

                        <!-- Logo (uses theme resource "CpeLogo") -->
                        <Image Grid.Column="1"
                               Source="{DynamicResource CpeLogo}"
                               Height="70"
                               Stretch="Uniform"
                               VerticalAlignment="Bottom"
                               Margin="-10,-10,-10,-10"/>

                        <TextBlock Grid.Column="2"
                                   Text="Radio Shop"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                    </Grid>

                    <!-- Authorized use (make stronger / Primary) -->
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold"
                               Text="Authorized use only. Do not distribute outside CenterPoint Energy Radio Shop."
                               Margin="0,0,0,26"/>

                    <!-- Licensing -->
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}">
                        <Run Text="Icon licensing: "/>
                        <Run Text="Inventory icons created by Uniconlabs - Flaticon"/>
                    </TextBlock>

                </StackPanel>

                <!-- Bottom buttons -->
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Close"
                            Width="130"
                            Height="38"
                            Padding="18,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Grid>

        </Border>
    </Grid>
</Window>
