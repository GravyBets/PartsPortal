<UserControl x:Class="PartsPortal.Views.SiteTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PartsPortal.Views">

    

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Parts Browser (spans both rows) -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="2"
                Style="{StaticResource SurfaceCardStyle}"
                Margin="0,0,8,0">

            <views:PartsBrowserView x:Name="Parts"
                                    x:FieldModifier="public"/>
        </Border>

        <!-- TOP-RIGHT: Movement + Inputs -->
        <Border Grid.Row="0"
        Grid.Column="1"
        Style="{StaticResource SurfaceCardStyle}"
        Margin="8,0,0,8">

            <views:MovementDetailsView x:Name="Movement"
                                       x:FieldModifier="public"/>
        </Border>


        <!-- BOTTOM-RIGHT: Selected Parts -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource SurfaceCardStyle}"
                Margin="8,8,0,0">

            <views:SelectedPartsView x:Name="Selected"
                                    x:FieldModifier="public"/>
        </Border>

    </Grid>
</UserControl>
