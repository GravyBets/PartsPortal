<UserControl x:Class="MaterialReqAppV3.Views.SelectedPartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Qty column text style -->
        <Style x:Key="QtyCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid cell padding like your code -->
        <Style x:Key="SelectedGridCellStyle" 
               TargetType="DataGridCell"
               BasedOn="{StaticResource ThemedDataGridCellStyle}">
        </Style>

        <!-- Row button base (reuse your theme buttons) -->
        <Style x:Key="SelectedActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selected parts grid -->
        <DataGrid x:Name="SelectedPartsGrid"
                  Style="{StaticResource ThemedDataGridStyle}"
                  x:FieldModifier="public"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  BorderThickness="0"                  
                  FontSize="14"
                  RowHeight="44"
                  ColumnHeaderHeight="30"
                  VerticalContentAlignment="Center"
                  IsReadOnly="True"
                  CellStyle="{StaticResource SelectedGridCellStyle}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Qty"
                                    Width="50"
                                    Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource QtyCellTextStyle}"
                                    IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Part"
                                        Width="*"
                                        CellTemplate="{StaticResource SelectedPartDisplayTemplate}"
                                        IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons row -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0">

            <Button x:Name="RemovePartButton"
                    x:FieldModifier="public"
                    Style="{StaticResource SelectedActionButton}"
                    Content="Remove Part"
                    Margin="0,0,10,0"/>

            <Button x:Name="ClearListButton"
                    x:FieldModifier="public"
                    Style="{StaticResource SelectedActionButton}"
                    Content="Clear List"/>

            <Button x:Name="SaveToTemplatesButton"
                    x:FieldModifier="public"
                    Style="{StaticResource SelectedActionButton}"
                    Content="Save to Templates"
                    Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   x:FieldModifier="public"
                   Grid.Row="2"
                   Foreground="IndianRed"
                   FontSize="13"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
