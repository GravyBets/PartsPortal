<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <Version>3.2.4</Version>
	  <AssemblyVersion>3.2.4.1</AssemblyVersion>
	  <FileVersion>3.2.4.1</FileVersion>
	  <InformationalVersion>3.2.4 (Not Released)</InformationalVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
	  <ApplicationIcon>Assets\PartsPortalIcon.ico</ApplicationIcon>
	  <AssemblyName>PartsPortal</AssemblyName>
	  <RootNamespace>PartsPortal</RootNamespace>
	  
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\CenterPointLogo_DarkText.png" />
    <None Remove="Assets\CenterPointLogo_LightText.png" />
    <None Remove="Assets\PartsPortalIcon.ico" />    
  </ItemGroup>

	<ItemGroup>
		<Content Include="Templates\*.pdf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>


	<ItemGroup>
    <PackageReference Include="Syncfusion.Licensing" Version="32.1.19" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="32.1.19" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CenterPointLogo_DarkText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\CenterPointLogo_LightText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\PartsPortalIcon.ico" />
  </ItemGroup>

</Project>
