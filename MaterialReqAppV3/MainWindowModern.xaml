<Window x:Class="MaterialReqAppV3.MainWindowModern"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material Requisition App"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackground}"        
        SnapsToDevicePixels="True"
        Icon="Assets/MaterialReqAppIcon.ico">

    <Window.Resources>

        <!-- Hover-only close "hit area" (used by your CreateTabHeader code) -->
        <Style x:Key="TabCloseHitStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Template that puts: Tabs header row, then SiteName row, then content -->
        <Style x:Key="TabControlWithSiteBarStyle"
       TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                              IsItemsHost="True"
                              Margin="0,0,0,-1"/>

                            <!-- Site name bar (under headers) -->
                            <Border Grid.Row="1"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,10">

                                <DockPanel LastChildFill="False">

                                    <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <TextBox x:Name="PART_SiteNameBox"
                                         Width="340"
                                         Height="34"
                                         Tag=" Site # / Reason for Movement"
                                         Margin="0,0,8,0"
                                         Style="{StaticResource ModernWatermarkTextBox}"/>

                                        <!-- If you want it to be secondary instead, swap style to SecondaryButtonStyle -->
                                        <Button Content="Apply"
                                                Height="34"
                                                MinWidth="96"
                                                Padding="16,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ApplySiteName_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Selected tab content -->
                            <ContentPresenter Grid.Row="2"
                                      ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        
        
        <!-- TAB LOOK: tabs "attach" to the bar border under them -->             
        <Style x:Key="AttachedTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="{DynamicResource TileFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>


            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10,10,0,0"
                        Padding="{TemplateBinding Padding}">

                            <Grid>
                                <ContentPresenter x:Name="HeaderPresenter"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource TextPrimary}"/>

                                <Border x:Name="Indicator"
                                Height="3"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource PrimaryBg}"
                                Opacity="0"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="Bd" Property="Margin" Value="0,0,6,-1"/>

                                <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="Bold"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>

                            <!-- Special case: Plus tab should never look selected/attached -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Tag" Value="Plus"/>
                                </MultiTrigger.Conditions>

                                <!-- Undo the “attached” selected look -->
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFill}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="Bd" Property="Margin" Value="0,0,6,0"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="0"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            </MultiTrigger>


                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Icon Button Styling-->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" 
                                     Value="True">
                                <Setter TargetName="Bd" 
                                        Property="Background" 
                                        Value="{DynamicResource HoverOverlay}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" 
                                     Value="True">
                                <Setter TargetName="Bd" 
                                        Property="Background" 
                                        Value="{DynamicResource PressedOverlay}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" 
                                     Value="False">
                                <Setter Property="Opacity" 
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="328*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top header -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- =======================
         TOP HEADER BAR
         ======================= -->
        <Border Grid.Row="0"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Margin="0,0,0,8" Grid.ColumnSpan="2">

            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LEFT: Header text -->
                <TextBlock x:Name="HeaderText"
                           Grid.Column="0"
                           Grid.Row="0"
                           Text="Material Requisition - Warehouse - Building D"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="HeaderSubText"
                           Grid.Column="0"
                           Grid.Row="1"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Generate PDF to Print or Email"/>

                <!-- RIGHT: Icon buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Home"
                            Click="Home_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="&#xE80F;"/>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Settings"
                            Margin="6,0,0,0"
                            Click="OpenSettings_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="&#xE713;"/>
                    </Button>

                </StackPanel>
            </Grid>

        </Border>

        <!-- =======================
                     TABS
            ======================= -->
        <TabControl x:Name="SiteTabs"
            Grid.Row="1"
            Style="{StaticResource TabControlWithSiteBarStyle}"
            SelectionChanged="SiteTabs_SelectionChanged"
            PreviewMouseLeftButtonDown="SiteTabs_PreviewMouseLeftButtonDown"
            ItemContainerStyle="{StaticResource AttachedTabItemStyle}" Grid.ColumnSpan="2" Margin="0,0,0,44" Grid.RowSpan="2">

            <!-- Default site tab -->
            <TabItem x:Name="FirstBlankTab"
             Header="Blank"
             Tag="False" Margin="0,0,6,0">

                

                <!-- 2x2 layout -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
            Style="{StaticResource SurfaceCardStyle}"
            Margin="0,0,8,8">
                        <TextBlock Text="Movement Type (Top-Left)"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="18"
                   FontWeight="SemiBold"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
            Style="{StaticResource SurfaceCardStyle}"
            Margin="8,0,0,8">
                        <TextBlock Text="Cost Center / WBS / Work Order (Top-Right)"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="18"
                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Parts Catalog -->
                    <Border Grid.Row="1" Grid.Column="0"
            Style="{StaticResource SurfaceCardStyle}"
            Margin="0,8,8,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search (force single-line behavior even though the style is "multiline") -->
                            <TextBox x:Name="PartsSearchBox"
                     Height="34"
                     Margin="0,0,0,10"
                     Tag="Search parts..."
                     Style="{StaticResource WatermarkTextBoxMultilineStyle}"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Disabled"
                     Padding="12,0"
                     TextChanged="PartsSearchBox_TextChanged"/>

                            <ListBox x:Name="PartsListBox"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"
                     ItemTemplate="{StaticResource PartItemTemplate}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
            Style="{StaticResource SurfaceCardStyle}"
            Margin="8,8,0,0">
                        <TextBlock Text="Selected Parts (Bottom-Right)"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="18"
                   FontWeight="SemiBold"/>
                    </Border>

                </Grid>

            </TabItem>


            <!-- Plus tab -->
            <TabItem x:Name="PlusTab"
                     Tag="Plus"
                     Width="36"
                     ToolTip="New tab"
                     Padding="0">
                <TabItem.Header>
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE710;"
                   FontSize="13"
                   FontWeight="Regular"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

                </TabItem.Header>
                <Grid/>
            </TabItem>



        </TabControl>


        <!-- =======================
         BOTTOM BAR
         ======================= -->
        <Grid Grid.Row="2" 
              Margin="0,10,0,0" 
              Grid.ColumnSpan="2">
            <Button Content="Summary"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Height="34"
                    Width="90"
                    Padding="18,0"
                    Click="OpenSummary_Click"/>
        </Grid>
    </Grid>



</Window>
