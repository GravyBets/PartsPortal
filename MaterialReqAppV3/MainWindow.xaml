<Window x:Class="MaterialReqAppV3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material Requisition App"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBg}">

    <Window.Resources>

        <!-- =========================
             SOFT THEME (LIGHT)
             ========================= -->
        <SolidColorBrush x:Key="AppBg" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="SurfaceBorder" Color="#D7DCE3"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4B5563"/>
        <SolidColorBrush x:Key="HoverOverlay" Color="#14000000"/>

        <!-- TextBox with watermark (uses Tag as the watermark text) -->
        <Style x:Key="WatermarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"/>

                            <TextBlock x:Name="Watermark"
                       Text="{TemplateBinding Tag}"
                       Foreground="#9AA3AF"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>

                            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hover-only close "hit area" (used by your CreateTabHeader code) -->
        <Style x:Key="TabCloseHitStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill toggle style (Issue/Return) -->
        <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Pill background -->
                            <Border x:Name="Pill"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                <Grid Margin="10,0,10,0">
                                    <TextBlock x:Name="Label"
                                               Text="Issue"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Knob -->
                            <Border x:Name="Knob"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#F1F3F5"
                                    BorderBrush="#CFCFCF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    Margin="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Text" Value="Return"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Left"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#BFC6D1"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template that puts: Tabs header row, then SiteName row, then content -->
        <Style x:Key="TabControlWithSiteBarStyle"
               TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0,0,0,0"/>

                            <!-- Site name bar (under headers) -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,6,0,10">
                                <DockPanel LastChildFill="False">

                                    <!-- Left side -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Issue/Return pill: per-tab state in TabItem.Tag -->
                                        <ToggleButton Margin="0,0,14,0"
                                                      Style="{StaticResource PillToggleStyle}"
                                                      IsChecked="{Binding SelectedItem.Tag, RelativeSource={RelativeSource AncestorType=TabControl}, Mode=TwoWay}"
                                                      Checked="IssueReturnToggle_Changed"
                                                      Unchecked="IssueReturnToggle_Changed"/>

                                        <TextBox x:Name="PART_SiteNameBox"
                                                 Width="260"
                                                 Height="26"
                                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                                 Tag="Reason for Movement/Site #"
                                                 Margin="0,0,6,0"
                                                 Background="{DynamicResource SurfaceBg}"
                                                 BorderBrush="{DynamicResource SurfaceBorder}"
                                                 BorderThickness="1"/>


                                        <Button Content="Apply"
                                                Height="26"
                                                Padding="12,0"
                                                Click="ApplySiteName_Click"/>
                                    </StackPanel>

                                </DockPanel>
                            </Border>

                            <!-- Selected tab content -->
                            <ContentPresenter Grid.Row="2"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Template for Data Boxes-->
        <DataTemplate x:Key="PartItemTemplate">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Description}"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Material}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,1,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!--Template for Selected Parts Grid-->
        <DataTemplate x:Key="SelectedPartDisplayTemplate">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Description}"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Material}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,1,0,0"/>
            </StackPanel>
        </DataTemplate>


    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top header -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- =======================
         TOP HEADER BAR
         ======================= -->
        <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Margin="0,0,0,10">
            <DockPanel LastChildFill="True">

                <!-- Right side buttons -->
                <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <Button Content="Test CSV"
                            Height="30"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Click="TestCsv_Click"/>
                    <Button Content="Settings"
                        Height="30"
                        Padding="14,0"
                        Click="OpenSettings_Click"/>
                </StackPanel>

                <!-- Left header text -->
                <TextBlock x:Name="HeaderText"
                       Text="Material Requisition - Warehouse - Building *"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- =======================
         TABS
         ======================= -->
        <TabControl x:Name="SiteTabs"
                Grid.Row="1"
                Style="{StaticResource TabControlWithSiteBarStyle}"
                SelectionChanged="SiteTabs_SelectionChanged"
                PreviewMouseLeftButtonDown="SiteTabs_PreviewMouseLeftButtonDown">

            <!-- Default site tab -->
            <TabItem x:Name="FirstBlankTab"
                 Header="Blank"
                 Tag="False">

                <!-- 2x2 layout -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,8,8">
                        <TextBlock Text="Movement Type (Top-Left)"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="8,0,0,8">
                        <TextBlock Text="Cost Center / WBS / Work Order (Top-Right)"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    </Border>

                    <!--Parts Catalog-->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,8,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="PartsSearchBox"
                                     Height="28"
                                     Margin="0,0,0,10"
                                     Tag="Search parts..."
                                     Style="{StaticResource WatermarkTextBoxStyle}"
                                     TextChanged="PartsSearchBox_TextChanged"/>

                            <ListBox x:Name="PartsListBox"
                                     Grid.Row="1"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <!-- Description (primary) -->
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>

                                            <!-- Material (secondary) -->
                                            <TextBlock Text="{Binding Material}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Grid>
                    </Border>


                    <Border Grid.Row="1" Grid.Column="1"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="8,8,0,0">
                        <TextBlock Text="Selected Parts (Bottom-Right)"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Plus tab -->
            <TabItem x:Name="PlusTab"
                 Header="+"
                 Width="35">
                <Grid/>
            </TabItem>

        </TabControl>

        <!-- =======================
         BOTTOM BAR
         ======================= -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Generate PDF"
                HorizontalAlignment="Right"
                Height="34"
                Padding="18,0"
                Click="GeneratePdf_Click"/>
        </Grid>
    </Grid>



</Window>
