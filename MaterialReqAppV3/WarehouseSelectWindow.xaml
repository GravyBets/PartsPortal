<Window x:Class="MaterialReqAppV3.WarehouseSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MaterialReqAppV3"
        mc:Ignorable="d"
        Title="WarehouseSelectWindow" Height="450" Width="800">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select the warehouse you are ordering parts for:"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Rows="2" Columns="2">

            <Button Content="Warehouse - Building D"
                FontSize="18"
                Margin="10"
                Click="Warehouse_Click"/>

            <Button Content="Warehouse - Building B"
                FontSize="18"
                Margin="10"
                Click="Warehouse_Click"/>

            <Button Content="Warehouse - Building A"
                FontSize="18"
                Margin="10"
                Click="Warehouse_Click"/>

            <Button Content="Warehouse - Building F"
                FontSize="18"
                Margin="10"
                Click="Warehouse_Click"/>

        </UniformGrid>

    </Grid>

</Window>
