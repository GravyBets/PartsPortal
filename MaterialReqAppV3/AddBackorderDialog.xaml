<Window x:Class="MaterialReqAppV3.AddBackorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Backorder"
        Height="470"
        Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- Line item template (simple + readable) -->
        <DataTemplate x:Key="BackorderLineTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource TileFill}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Qty}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Work Order"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding WorkOrder}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Site / Reason"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding SiteReason}"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Remove"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="30"
                        Padding="12,0"
                        Margin="12,0,0,0"
                        Click="RemoveLine_Click"/>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Part header -->
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14">
            <StackPanel>
                <TextBlock x:Name="PartDesc"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PartMat"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="2,10,0,8"
                   Text="Enter Qty + Work Order + Site/Reason, then click Add Line. Add as many lines as needed."
                   Foreground="{DynamicResource TextSecondary}"/>

        <!-- Main card -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Input row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Qty -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Qty"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="QtyBox"
                                 Height="34"
                                 Text="1"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 PreviewTextInput="QtyBox_PreviewTextInput"/>
                    </StackPanel>

                    <!-- Work Order -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Work Order (required)"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="WorkOrderBox"
                                 Height="34"
                                 Tag="Work order..."
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 KeyDown="InputBox_KeyDown"/>
                    </StackPanel>

                    <!-- Site / Reason -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Site / Reason (optional)"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="SiteReasonBox"
                                 Height="34"
                                 Tag="Site # / Reason..."
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 KeyDown="InputBox_KeyDown"/>
                    </StackPanel>

                    <!-- Add line -->
                    <Button Grid.Column="3"
                            Content="Add Line"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="34"
                            Padding="16,0"
                            VerticalAlignment="Bottom"
                            Click="AddLine_Click"/>
                </Grid>

                <!-- Lines label -->
                <Grid Grid.Row="1" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Lines to add"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=LinesList, Path=Items.Count, StringFormat={}{0} line(s)}"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>

                <!-- Lines list -->
                <ListBox Grid.Row="2"
                         x:Name="LinesList"
                         Style="{StaticResource ThemedListBoxStyle}"
                         ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"
                         ItemTemplate="{StaticResource BackorderLineTemplate}"
                         BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Content="Add to Backorders"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
