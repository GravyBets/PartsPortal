<Window x:Class="MaterialReqAppV3.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        Title="Summary"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Icon="Assets/MaterialReqAppIcon.ico">
    
    <Window.Resources>

        <!-- Summary-only cell style (based on theme) -->
        <Style x:Key="SummaryCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource ThemedDataGridCellStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- Summary-only row style (red highlight + hover on red rows) -->
        <Style x:Key="SummaryRowStyle"
               TargetType="DataGridRow"
           BasedOn="{StaticResource ThemedDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MissingRef}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MissingRefBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MissingRefBorder}"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding MissingRef}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource MissingRefBgHover}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Order Summary"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="SubText"
                           Text="Red = missing Work Order / Cost Center / WBS."
                           FontSize="13"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">

            <DataGrid x:Name="SummaryGrid"
                      Style="{StaticResource ThemedDataGridStyle}"
                      RowStyle="{StaticResource SummaryRowStyle}"
                      CellStyle="{StaticResource SummaryCellStyle}"
                      
                        ScrollViewer.CanContentScroll="False"
                        PreviewMouseWheel="SummaryGrid_PreviewMouseWheel"
                      
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      MinRowHeight="46"
                      ColumnHeaderHeight="34"
                      FontSize="14"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Resources>
                    <!-- Parts cell template -->
                    <DataTemplate x:Key="PartsCellTemplate">
                        <ItemsControl ItemsSource="{Binding Parts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimary}">
                                            <Run Text="{Binding Qty}"/>
                                            <Run Text=" x "/>
                                            <Run Text="{Binding Description}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Material}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>


                    <!-- Centered text style -->
                    <Style x:Key="CenteredCellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                    </Style>

                    <!-- Summary-only cell style (based on theme) -->
                    <Style x:Key="SummaryCellStyle"
                           TargetType="DataGridCell"
                           BasedOn="{StaticResource ThemedDataGridCellStyle}">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                    </Style>

                    <Style x:Key="SummaryRowStyle"
                           TargetType="DataGridRow"
                           BasedOn="{StaticResource ThemedDataGridRowStyle}">

                        <Style.Triggers>
                            <!-- Red highlight when MissingRef -->
                            <DataTrigger Binding="{Binding MissingRef}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MissingRefBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource MissingRefBorder}"/>
                            </DataTrigger>

                            <!-- Keep a hover effect even on red rows -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding MissingRef}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource MissingRefBgHover}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Site # / Reason" 
                                        Width="140"
                                        Binding="{Binding Tab}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTextColumn Header="Issue / Return" 
                                        Width="140"
                                        Binding="{Binding Type}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTextColumn Header="Order #" 
                                        Width="170"
                                        Binding="{Binding RefValue}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTemplateColumn Header="Parts / Qty" 
                                            Width="*"
                                            CellTemplate="{StaticResource PartsCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>


        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Cancel"
                    Style="{DynamicResource SecondaryButtonStyle}"                    
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>            

            <Button Content="Generate"
                    Style="{DynamicResource SecondaryButtonStyle}"                    
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Generate_Click"/>

            <Button Content="Email Draft"
                    Style="{DynamicResource SecondaryButtonStyle}"                     
                    Margin="0,0,8,0" 
                    Click="EmailDraft_Click"/>

            <Button Content="Email"
                    Style="{DynamicResource PrimaryButtonStyle}"                    
                    Margin="0,0,8,0"
                    Click="Email_Click"/>
        </StackPanel>

    </Grid>
</Window>
