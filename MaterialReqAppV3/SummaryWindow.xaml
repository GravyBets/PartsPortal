<Window x:Class="MaterialReqAppV3.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Summary"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBg}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Order Summary"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="SubText"
                           Text="Yellow = missing Site#/Reason. Red = missing Work Order / Cost Center / WBS."
                           FontSize="12"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">

            <DataGrid x:Name="SummaryGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      MinRowHeight="46"
                      ColumnHeaderHeight="34"
                      FontSize="14"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Resources>
                    <!-- Parts cell template -->
                    <DataTemplate x:Key="PartsCellTemplate">
                        <ItemsControl ItemsSource="{Binding Parts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimary}">
                                            <Run Text="{Binding Qty}"/>
                                            <Run Text=" x "/>
                                            <Run Text="{Binding Description}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Material}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>

                    <!-- Centered text style -->
                    <Style x:Key="CenteredCellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                    </Style>

                    <!-- Cell padding -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                    </Style>
                    <!-- Row styling: separator line + missing-data highlights -->
                    <Style TargetType="DataGridRow">
                        <!-- line between rows -->
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Background" Value="Transparent"/>

                        <Style.Triggers>
                            <!-- Yellow if missing Site#/Reason -->
                            <DataTrigger Binding="{Binding MissingReason}" Value="True">
                                <Setter Property="Background" Value="#FEF9C3"/>
                            </DataTrigger>

                            <!-- Red if missing Work Order/Cost Center/WBS (wins over yellow) -->
                            <DataTrigger Binding="{Binding MissingRef}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tab"
                                        Width="220"
                                        Binding="{Binding Tab}"
                                        ElementStyle="{StaticResource CenteredCellText}" />

                    <DataGridTextColumn Header="Type"
                                        Width="90"
                                        Binding="{Binding Type}"
                                        ElementStyle="{StaticResource CenteredCellText}" />

                    <DataGridTextColumn Header="#"
                                        Width="170"
                                        Binding="{Binding RefValue}"
                                        ElementStyle="{StaticResource CenteredCellText}" />

                    <DataGridTemplateColumn Header="Parts / Qty"
                                            Width="*"
                                            CellTemplate="{StaticResource PartsCellTemplate}" />
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Cancel"
                    Width="110"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Content="Generate"
                    Width="110"
                    Height="34"
                    IsDefault="True"
                    Click="Generate_Click"/>
        </StackPanel>
    </Grid>
</Window>
