<Window x:Class="MaterialReqAppV3.BugFeatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bug / Feature Request"
        Height="540" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        Icon="Assets/MaterialReqAppIcon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header card -->
        <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Bug / Feature Request"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Describe the issue or request. We'll open an Outlook draft with everything filled in."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Form card -->
        <Border Style="{StaticResource Card}" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Type row -->
                <Grid Grid.Row="0" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Type:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Grid.ColumnSpan="1" Height="16"/>

                    <ComboBox x:Name="TypeCombo"
                              Grid.Column="2"
                              Style="{StaticResource ModernComboBox}"
                              SelectedIndex="0" Margin="0,0,110,0">
                        <ComboBoxItem Content="Bug"/>
                        <ComboBoxItem Content="Feature"/>
                    </ComboBox>
                </Grid>

                <!-- Details label -->
                <TextBlock Grid.Row="1"
                           Text="Details:"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,6"/>

                <!-- Details box -->
                <TextBox x:Name="DetailsBox"
         Grid.Row="2"
         Grid.Column="1"
         Margin="0,10,0,0"
         Height="200"
         Style="{StaticResource WatermarkTextBoxMultilineStyle}"
         Tag="You find a bug? Tell me what happened, how to reproduce, any error messages, etc.

You want a feature added? Tell me in great detail what you want, how you want it to work, how does it benefit the app, etc."/>


                <!-- Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Cancel"
                            Width="130"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                            Margin="0,0,10,0"/>

                    <Button Content="Open Email Draft"
                            Width="190"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Send_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
