<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="clr-namespace:System.Windows.Media.Imaging;assembly=PresentationCore">

    <!-- =========================
         DARK THEME
         ========================= -->

    <!-- App + cards -->
    <SolidColorBrush x:Key="AppBackground" Color="#151C2B"/>
    <SolidColorBrush x:Key="CardBackground" Color="#1F2838"/>
    <SolidColorBrush x:Key="CardBorder" Color="#34415C"/>

    <!-- Surfaces used inside cards -->
    <SolidColorBrush x:Key="SurfaceBg" Color="#252F44"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#34415C"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C2CCDE"/>
    <SolidColorBrush x:Key="WatermarkText" Color="#9AA6BC"/>

    <!-- Input (TextBox) border colors -->
    <SolidColorBrush x:Key="InputBorderHover" Color="#7C879A"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#3B82F6"/>

    <!-- Primary button hover/pressed -->
    <SolidColorBrush x:Key="PrimaryBgHover" Color="#2747A6"/>
    <SolidColorBrush x:Key="PrimaryBgPressed" Color="#223D93"/>


    <!-- Primary brand (calmer dark blue) -->
    <SolidColorBrush x:Key="PrimaryBg" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="PrimaryBorder" Color="#1E40AF"/>

    <!-- Tile background (subtle fill so buttons aren’t washed out) -->
    <SolidColorBrush x:Key="TileFill" Color="#2A3650"/>
    <SolidColorBrush x:Key="TileFillHover" Color="#324061"/>
    <SolidColorBrush x:Key="TileFillPressed" Color="#243149"/>

    <!-- Compat keys (some styles still reference these names) -->
    <SolidColorBrush x:Key="TileHoverBg" Color="#202A3B"/>
    <SolidColorBrush x:Key="TilePressedBg" Color="#162033"/>


    <!-- Overlays / Misc -->
    <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#22FFFFFF"/>    
    <SolidColorBrush x:Key="BorderHover" Color="#475569"/>

    <!-- CenterPoint logo for DARK mode (light text logo) -->
    <media:BitmapImage x:Key="CpeLogo"
                       UriSource="pack://application:,,,/Assets/CenterPointLogo_LightText.png"/>



</ResourceDictionary>
