<Window x:Class="PartsPortal.PartEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part"
        Width="600"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           Text="Add Part"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="A part can be assigned to one or more warehouses."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Material #:"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="MaterialTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         MaxLength="64"
                         Margin="0,0,0,12"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Description:"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="DescriptionTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         MaxLength="255"
                         Margin="0,0,0,12"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Warehouses:"
                           Style="{StaticResource FormLabelStyle}"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0"/>

                <StackPanel x:Name="WarehousePanel"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Width="110"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Save"
                    Width="110"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
