<Window x:Class="PartsPortal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        MinHeight="760"
        Width="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">

    <Window.Resources>               

        <!-- Readonly variant (slightly muted) -->
        <Style x:Key="ModernTextBoxReadOnly" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- Filtered View -->
        <CollectionViewSource x:Key="EmailDirectoryView"
                      Source="{Binding EmailDirectory}"
                      Filter="EmailDirectoryView_Filter"/>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header Card ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Update your info, paths, and email recipients."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- ===== Form Card ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Name -->
                    <RowDefinition Height="Auto"/> <!-- EmployeeId -->
                    <RowDefinition Height="Auto"/> <!-- Truck -->
                    <RowDefinition Height="Auto"/> <!-- Pdf Output -->
                    <RowDefinition Height="Auto"/> <!-- Csv -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="Auto"/> <!-- Email To -->
                    <RowDefinition Height="Auto"/> <!-- Email CC -->
                    <RowDefinition Height="Auto"/> <!-- Email DirectoryLabel -->
                    <RowDefinition Height="Auto"/> <!-- Email Directory Controls -->
                </Grid.RowDefinitions>

                <!-- Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="0"
                         Grid.Column="1" 
                         Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         MaxLength="32"
                         Margin="0,0,0,12"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Employee ID -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Employee ID:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBoxReadOnly}"
                         Margin="0,0,0,12"
                         Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Truck -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Truck #:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         MaxLength="16"
                         Margin="0,0,0,12"
                         Text="{Binding TruckNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- PDF Output Folder -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="PDF Save Folder:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"                         
                         Margin="0,0,10,12"
                         Text="{Binding PdfOutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="3" Grid.Column="2"
                        Content="Browse..."
                        Height="34"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowsePdfFolder_Click"/>

                <!-- Parts CSV Path -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Parts CSV Path:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,10,12"
                         Text="{Binding CsvPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="4" Grid.Column="2"
                        Content="Browse..."
                        Height="34"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseCsv_Click"/>

                <!-- Divider -->
                <Border Grid.Row="5" Grid.ColumnSpan="3"
                        Height="1"
                        Background="{DynamicResource CardBorder}"
                        Opacity="0.7"
                        Margin="0,6,0,16"/>

                <!-- Email To -->
                <TextBlock Grid.Row="6" 
                           Grid.Column="0" 
                           Text="Email To:" 
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="6" 
                         Grid.Column="1" 
                         Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"
                         Height="Auto"
                         MinHeight="34"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         MinLines="1"
                         MaxLines="4"
                         Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Email CC -->
                <TextBlock Grid.Row="7" 
                           Grid.Column="0" 
                           Text="Email CC:" 
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="7" 
                         Grid.Column="1" 
                         Grid.ColumnSpan="2"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"
                         Height="Auto"
                         MinHeight="34"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         MinLines="1"
                         MaxLines="4"
                         Text="{Binding EmailCc, UpdateSourceTrigger=PropertyChanged}"/> 

                    <!-- Email Directory Label -->
                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="Email Directory:"
                               Style="{StaticResource FormLabelStyle}"
                               VerticalAlignment="Top"
                               Margin="0,12,0,0"/>

                    <!-- Email Directory Controls -->
                    <Grid Grid.Row="8"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Search -->
                            <RowDefinition Height="160"/> <!-- List + buttons -->
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <TextBox x:Name="EmailSearchBox"
                                 Grid.Row="0"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Tag="Search Email..."
                                 Height="34"
                                 Margin="0,0,0,10"
                                 VerticalContentAlignment="Center"
                                 TextChanged="EmailSearchBox_TextChanged"
                                 ToolTip="Search by first name, last name, or email" />

                        <!-- List + Buttons -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <!-- List -->
                            <ListBox x:Name="EmailDirectoryListBox"
                                     Grid.Column="0"
                                     Margin="0,0,10,0"
                                     Height="160"
                                     ItemsSource="{Binding Source={StaticResource EmailDirectoryView}}"
                                     DisplayMemberPath="DisplayName"
                                     Style="{StaticResource ThemedListBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VerticalAlignment="Top"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="1"
                                        Height="160"
                                        VerticalAlignment="Top">

                                <Button Content="Add ➔ To"
                                        Height="34"
                                        Margin="0,0,0,8"
                                        Click="CopyTo_Click">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=EmailDirectoryListBox}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Add ➔ CC"
                                        Height="34"
                                        Margin="0,0,0,8"
                                        Click="CopyCc_Click">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=EmailDirectoryListBox}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Remove Entry"
                                        Height="34"
                                        Margin="0,0,0,8"
                                        Click="RemoveEmail_Click">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=EmailDirectoryListBox}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Add Entry"
                                        Height="34"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddEmail_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>                                                                                                                                                                                                                                                                                  
            </Grid>
        </Border>

        <!-- ===== Bottom Buttons ===== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Save"
                    Width="110"
                    Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
