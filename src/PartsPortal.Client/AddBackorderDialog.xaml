<Window x:Class="PartsPortal.AddBackorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Backorder"
        Width="720"
        Height="282"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="NoResize">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="Auto"/>
            <!-- card -->
            <RowDefinition Height="Auto"/>
            <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Part header -->
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,10">

            <StackPanel>
                <TextBlock x:Name="PartDesc"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="PartMat"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Main card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- instruction -->
                    <RowDefinition Height="Auto"/>
                    <!-- inputs -->
                </Grid.RowDefinitions>

                <!-- Instruction (moved into card, PrimaryText style feel) -->
                <TextBlock Grid.Row="0"
                           Text="Enter Site # / Reason, Work Order, and Qty, then click Add."
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold"/>

                <!-- Inputs: Site/Reason | Work Order | Qty -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Site/Reason -->
                    <TextBox x:Name="SiteReasonBox"
                             Grid.Column="0"
                             Height="34"
                             Margin="0,0,10,0"
                             MaxLength="32"
                             Tag="Site # / Reason..."
                             Style="{StaticResource ModernWatermarkTextBox}"
                             KeyDown="InputBox_KeyDown"/>

                    <!-- Work Order -->
                    <TextBox x:Name="WorkOrderBox"
                             Grid.Column="1"
                             Height="34"
                             Margin="0,0,10,0"
                             MaxLength="32"
                             Tag="Work Order #"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             KeyDown="InputBox_KeyDown"/>

                    <!-- Qty (editable: dropdown 1-10, but can type >10) -->
                    <ComboBox x:Name="QtyCombo"
                              Grid.Column="2"
                              Height="34"
                              Width="100"
                              MinWidth="100"
                              Style="{StaticResource ModernComboBox}"                              
                              PreviewTextInput="QtyCombo_PreviewTextInput"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,0">

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="110"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Add"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="110"
                    Height="34"
                    Click="Add_Click"
                    IsDefault="True"/>
        </StackPanel>

    </Grid>
</Window>
