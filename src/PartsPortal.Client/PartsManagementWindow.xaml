<Window x:Class="PartsPortal.PartsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parts Management"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Parts Management"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Add, edit, deactivate, delete, and assign parts to warehouses."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernWatermarkTextBox}"
                         Tag="Search material, description, or warehouse..."
                         Height="36"
                         TextChanged="SearchBox_TextChanged"/>

                <CheckBox x:Name="IncludeInactiveCheckBox"
                          Grid.Column="1"
                          Margin="16,0,16,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Content="Show inactive"
                          Checked="IncludeInactiveCheckBox_Changed"
                          Unchecked="IncludeInactiveCheckBox_Changed"/>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="8">
            <DataGrid x:Name="PartsGrid"
                      Style="{StaticResource AdminDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionChanged="PartsGrid_SelectionChanged"
                      MouseDoubleClick="PartsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material"
                                        Binding="{Binding MaterialNumber}"
                                        ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Warehouses"
                                        Binding="{Binding WarehouseDisplay}"
                                        ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="320"/>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusDisplay}"
                                        ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="Add Part"
                        Width="110"
                        Margin="0,0,4,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Add_Click"/>
                <Button x:Name="DeleteButton"
                        Content="Delete Part"
                        Width="110"
                        Margin="0,0,4,0"
                        Style="{StaticResource DangerButtonStyle}"
                        IsEnabled="False"
                        Click="Delete_Click"/>
                <Button x:Name="EditButton"
                        Content="Edit"
                        Width="100"
                        Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="Edit_Click"/>
                <Button x:Name="ActiveToggleButton"
                        Content="Deactivate"
                        Width="120"
                        Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="ActiveToggle_Click"/>
                
                <Button Content="Close"
                        Width="100"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
