<Window x:Class="PartsPortal.UserAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Access"
        Width="960"
        Height="620"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="User Access"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Assign PartsPortal administration roles by Windows employee ID."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="New User"
                        Width="110"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewUser_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             Height="34"
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Tag="Search employee ID, name, or role..."
                             TextChanged="SearchBox_TextChanged"/>

                    <DataGrid x:Name="UsersGrid"
                              Grid.Row="1"
                              Style="{StaticResource AdminDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="UsersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee ID"
                                                Binding="{Binding EmployeeId}"
                                                ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="130"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding DisplayName}"
                                                ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="*"/>
                            <DataGridTextColumn Header="Roles"
                                                Binding="{Binding RolesDisplay}"
                                                ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="180"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding StatusDisplay}"
                                                ElementStyle="{StaticResource AdminDataGridTextStyle}"
                                        Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle"
                               Text="Select a user"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,16"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Employee ID"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox x:Name="EmployeeIdBox"
                             MaxLength="64"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Display Name"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox x:Name="DisplayNameBox"
                             MaxLength="128"
                             Margin="0,0,0,18"/>

                    <CheckBox x:Name="ActiveCheckBox"
                              Content="Active user"
                              IsChecked="True"
                              Margin="0,0,0,14"
                              Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Roles"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <CheckBox x:Name="AdminCheckBox"
                              Content="Administrator"
                              Margin="0,0,0,8"
                              Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Can manage users and parts."
                               Margin="24,-4,0,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <CheckBox x:Name="PartsManagerCheckBox"
                              Content="Parts Manager"
                              Margin="0,0,0,8"
                              Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Can add, edit, deactivate, reactivate, and assign parts."
                               Margin="24,-4,0,18"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <Button x:Name="SaveButton"
                            Content="Save Access"
                            Height="36"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="Refresh"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Refresh_Click"/>
                <Button Content="Close"
                        Width="100"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
