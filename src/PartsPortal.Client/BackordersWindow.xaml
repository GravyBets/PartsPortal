<Window x:Class="PartsPortal.BackordersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backordered Parts"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" 
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">

    <Window.Resources>
        <!--Icon Button Styling-->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" 
                             Value="True">
                                <Setter TargetName="Bd" 
                                Property="Background" 
                                Value="{DynamicResource HoverOverlay}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" 
                             Value="True">
                                <Setter TargetName="Bd" 
                                Property="Background" 
                                Value="{DynamicResource PressedOverlay}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" 
                             Value="False">
                                <Setter Property="Opacity" 
                                Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ONE root container -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Backordered Parts Log"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Track parts you need to order later. Select rows to generate or email."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- HOME -->
                    <Button Style="{StaticResource IconButtonStyle}"                            
                            ToolTip="Home"
                            Margin="0,0,10,0"
                            Click="Home_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="&#xE80F;"/>
                    </Button>

                    <!-- SETTINGS -->
                    <Button Style="{StaticResource IconButtonStyle}"                            
                            ToolTip="Settings"
                            Margin="0,0,16,0"
                            Click="Settings_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="&#xE713;"/>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTENT (your existing 3-column layout) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search + All Parts -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <TextBox x:Name="PartsSearchBox"
                         Height="34"
                         Margin="0,0,0,10"
                         Tag="Search parts..."
                         Style="{StaticResource ModernWatermarkTextBox}"
                         TextChanged="PartsSearchBox_TextChanged"/>

                <!-- All Parts list -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="10">

                    <ListBox x:Name="AllPartsListBox"
                             Style="{StaticResource ThemedListBoxInTabsStyle}"
                             ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"
                             ItemTemplate="{StaticResource PartItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             MouseDoubleClick="AllPartsListBox_MouseDoubleClick"/>
                </Border>

                <Button Grid.Row="2"
                        Content="Add"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Click="AddToBackorder_Click"/>
            </Grid>

            <!-- RIGHT: Backorder cart -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Backorder Cart"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Double-click a part on the left to add Qty, Work Order, and Site/Reason."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <DataGrid x:Name="BackorderGrid"
                              Grid.Row="1"
                              Margin="0,12,0,0"
                              Style="{StaticResource ThemedDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              MinRowHeight="46"
                              ColumnHeaderHeight="34"
                              FontSize="14"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="42" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="SelectAllCheck"
                                              IsThreeState="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ToolTip="Select all / none"
                                              Checked="SelectAllCheck_Changed"
                                              Unchecked="SelectAllCheck_Changed" />
                                </DataGridTemplateColumn.Header>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTextColumn Header="Date"
                                                Width="95"
                                                Binding="{Binding DateAdded, StringFormat={}{0:MM/dd/yyyy}}"/>                            

                            <!-- Part (template) -->
                            <DataGridTemplateColumn Header="Part" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Description}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Material}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Site / Reason"
                                                Width="220"
                                                Binding="{Binding SiteReason}"/>
                            
                            <DataGridTextColumn Header="WO"
                                                Width="140"
                                                Binding="{Binding WorkOrder}"/>

                            <DataGridTextColumn Header="Qty"
                                                Width="50"
                                                Binding="{Binding Qty}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Button row -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">                        

                        <Button x:Name="EditSelectedButton"
                                Content="Edit Highlighted"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="EditSelected_Click"/>

                        <Button x:Name="RemoveSelectedButton"
                                Content="Remove Selected"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="RemoveSelected_Click"/>

                        <Button x:Name="GenerateButton"
                                Content="Generate"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="Generate_Click"/>

                        <Button x:Name="EmailDraftButton"
                                Content="Email Draft"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="EmailDraft_Click"/>

                        <Button x:Name="EmailButton"
                                Content="Email"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Email_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
