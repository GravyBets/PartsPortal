<UserControl x:Class="PartsPortal.Views.PartsBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <UserControl.Resources>
        <!-- Qty column text style (what you created in code) -->
        <Style x:Key="QtyCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Button base (reuse your existing button styles) -->
        <Style x:Key="PartsActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- Small in-field clear action; follows every active theme. -->
        <Style x:Key="ClearPartsSearchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearSurface"
                                        Property="Background"
                                        Value="{DynamicResource TileFillHover}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClearSurface"
                                        Property="Background"
                                        Value="{DynamicResource TileFillPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Equivalent of partsPanel Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- tabs -->
            <RowDefinition Height="Auto"/>
            <!-- button row -->
        </Grid.RowDefinitions>

        <!-- Inner tabs -->
        <TabControl x:Name="PartsTabs"
            x:FieldModifier="public"
            Grid.Row="0"
            Style="{StaticResource PartsInnerTabControlStyle}"
            ItemContainerStyle="{StaticResource PartsInnerTabItemStyle}"
            Margin="0"
            Padding="0"
            Background="Transparent"
            BorderThickness="0">



            <!-- ALL PARTS -->
            <TabItem Header="All Parts">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

            <!-- Clear search without leaving the selected tab. -->
            <Grid Grid.Row="0" Margin="0,0,0,0">
                <TextBox x:Name="PartsSearchBox"
                         x:FieldModifier="public"
                         MaxLength="128"
                         Height="34"
                         Margin="4,8,4,0"
                         Padding="12,0,42,0"
                         Tag="Search parts..."
                         Style="{StaticResource ModernWatermarkTextBox}"
                         TextChanged="PartsSearchBox_TextChanged"/>
    
                <Button x:Name="ClearPartsSearchButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Style="{StaticResource ClearPartsSearchButtonStyle}"
                        Visibility="Collapsed"
                        ToolTip="Clear search"
                        Click="ClearPartsSearchButton_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>

                <ListBox x:Name="AllPartsListBox"
                         Grid.Row="1"
                         x:FieldModifier="public"
                         Style="{StaticResource ThemedListBoxInTabsStyle}"
                         ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"
                         ItemTemplate="{StaticResource PartItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0">
                
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add to Favorites" x:Name="AddFavMenuItem"/>
                            <MenuItem Header="Remove from Favorites" x:Name="RemoveFavFromAllMenuItem"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                </Grid>
            </TabItem>

            <!-- FAVORITES -->
            <TabItem Header="Favorites">
                <ListBox x:Name="FavPartsListBox"
                         x:FieldModifier="public"
                         Style="{StaticResource ThemedListBoxInTabsStyle}"
                         ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}"
                         ItemTemplate="{StaticResource PartItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from Favorites" x:Name="RemoveFavMenuItem"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </TabItem>

            <!-- TEMPLATES -->
            <TabItem Header="Templates">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="TemplatesListBox"
                             x:FieldModifier="public"
                             Grid.Column="0"
                             BorderThickness="0"
                             
                             Style="{StaticResource ThemedListBoxStyle}"
                             ItemContainerStyle="{StaticResource ThemedListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>




                    <!-- Preview grid -->
                    <DataGrid x:Name="TemplateLinesGrid"
                              Style="{StaticResource ThemedDataGridStyle}"
                              Grid.Column="1"
                              Margin="10,0,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              IsReadOnly="True"
                              RowHeight="44"
                              FontSize="14"
                              ColumnHeaderHeight="30"
                              ItemsSource="{Binding SelectedItem.Lines, ElementName=TemplatesListBox}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Qty"
                                                Width="50"
                                                Binding="{Binding Qty}"
                                                ElementStyle="{StaticResource QtyCellTextStyle}"/>

                            <DataGridTemplateColumn Header="Part"
                                                    Width="*"
                                                    CellTemplate="{StaticResource SelectedPartDisplayTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Button row -->
        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            Margin="0,10,0,0">

            <!-- Add to Order (always visible) -->
            <Button x:Name="AddToOrderButton"
                    x:FieldModifier="public"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="34"
                    Padding="14,0"
                    Content="Add to Order"/>

            <!-- Delete Template (Templates tab only = index 2) -->
            <Button x:Name="DeleteTemplateButton"
                    x:FieldModifier="public"                    
                    Margin="8,0,0,0"
                    Content="Delete Template">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" 
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=PartsTabs}" 
                                         Value="2">
                                <Setter Property="Visibility" 
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Add to Favorites (All Parts tab only = index 0) -->
            <Button x:Name="AddToFavoritesButton"
                    x:FieldModifier="public"
                    Margin="8,0,0,0"
                    Content="Add to Favorites">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" 
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=PartsTabs}" 
                                         Value="0">
                                <Setter Property="Visibility" 
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Remove from Favorites (Favorites tab only = index 1) -->
            <Button x:Name="RemoveFromFavoritesButton"
                    x:FieldModifier="public"
                    Margin="8,0,0,0"
                    Content="Remove from Favorites">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" 
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=PartsTabs}" 
                                         Value="1">
                                <Setter Property="Visibility" 
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>

    </Grid>
</UserControl>
