<UserControl x:Class="PartsPortal.Views.MovementDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Movement Type -->
        <StackPanel Grid.Column="0">

            <!-- Header row: [Pill] [Movement Type] -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="IssueReturnPill"
                              x:FieldModifier="public"
                              Style="{StaticResource PillToggleStyle}"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Movement Type"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <!-- Code will fill this panel with RadioButtons -->
            <StackPanel x:Name="MovementOptionsPanel"
                        x:FieldModifier="public"/>
        </StackPanel>

        <!-- RIGHT: Details -->
        <StackPanel Grid.Column="1" Margin="12,0,0,0">

            <TextBlock Text="Details"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBox x:Name="DetailsBox"
                     x:FieldModifier="public"
                     Style="{StaticResource ModernWatermarkTextBox}"
                     MaxLength="32"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Tag="Work Order"/>

            
        </StackPanel>

    </Grid>
</UserControl>
