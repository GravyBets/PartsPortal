<UserControl x:Class="PartsPortal.Views.SelectedPartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Direct-entry Qty editor -->
        <Style x:Key="QtyEditorStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SelectedActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="SelectedPartsGrid"
                  Style="{StaticResource ThemedDataGridStyle}"
                  x:FieldModifier="public"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  FontSize="14"
                  RowHeight="44"
                  ColumnHeaderHeight="30"
                  IsReadOnly="False">

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Qty"
                                        Width="72"
                                        IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource QtyEditorStyle}"
                                     Text="{Binding Qty, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="6"
                                     GotKeyboardFocus="QtyTextBox_GotKeyboardFocus"
                                     PreviewTextInput="QtyTextBox_PreviewTextInput"
                                     PreviewKeyDown="QtyTextBox_PreviewKeyDown"
                                     DataObject.Pasting="QtyTextBox_Pasting"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Part"
                                        Width="*"
                                        CellTemplate="{StaticResource SelectedPartDisplayTemplate}"
                                        IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0">

            <Button x:Name="RemovePartButton"
                    x:FieldModifier="public"
                    Style="{StaticResource SelectedActionButton}"
                    Content="Remove Part"
                    Margin="0,0,8,0"/>

            <Button x:Name="ClearListButton"
                    x:FieldModifier="public"
                    Style="{StaticResource SelectedActionButton}"
                    Content="Clear List"
                    Margin="0,0,8,0"/>

            <Button x:Name="SaveToTemplatesButton"
                    x:FieldModifier="public"
                    Style="{StaticResource SelectedActionButton}"
                    Content="Save to Templates"/>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   x:FieldModifier="public"
                   Grid.Row="2"
                   Foreground="IndianRed"
                   FontSize="13"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
