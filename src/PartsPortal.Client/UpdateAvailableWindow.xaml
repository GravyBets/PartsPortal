<Window x:Class="PartsPortal.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PartsPortal Update"
        Width="560"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Icon="/Assets/PartsPortalIcon.ico">
    <Grid Margin="18">
        <Border Style="{DynamicResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="VersionText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <Border Grid.Row="1"
                        x:Name="RequiredBanner"
                        Margin="0,16,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource TileFill}"
                        BorderBrush="{DynamicResource PrimaryBorder}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock Text="This update is required to continue using PartsPortal."
                               Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="What's new"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <ItemsControl x:Name="ReleaseNotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,3">
                                        <Run Text="• "/>
                                        <Run Text="{Binding}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button x:Name="LaterButton"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Content="Later"
                            Click="Later_Click"
                            Margin="0,0,10,0"/>
                    <Button Style="{DynamicResource PrimaryButtonStyle}"
                            Content="Download Update"
                            Click="Download_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
