<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <_TargetId>ClickOnce</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <PublishDir>bin\Release\net8.0-windows\win-x64\clickonce\</PublishDir>
    <PublishUrl>http://10.130.206.135/partsportal/install/</PublishUrl>
    <InstallUrl>http://10.130.206.135/partsportal/install/</InstallUrl>
    <UpdateUrl>http://10.130.206.135/partsportal/install/</UpdateUrl>

    <Install>true</Install>
    <ApplicationVersion>3.2.11.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>

    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
    <TargetZone>LocalIntranet</TargetZone>
    <PublisherName>CenterPoint Energy Radio Shop</PublisherName>
    <ProductName>PartsPortal</ProductName>

    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <UpdateUrlEnabled>true</UpdateUrlEnabled>

    <BootstrapperEnabled>false</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <MapFileExtensions>true</MapFileExtensions>
  </PropertyGroup>
</Project>

