<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.2.18</Version>
    <AssemblyVersion>3.2.18</AssemblyVersion>
    <FileVersion>3.2.18</FileVersion>
    <InformationalVersion>3.2.18 (Released)</InformationalVersion>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\PartsPortalIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PartsPortal</AssemblyName>
    <RootNamespace>PartsPortal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\CenterPointLogo_DarkText.png" />
    <None Remove="Assets\CenterPointLogo_LightText.png" />
    <None Remove="Assets\PartsPortalIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Licensing" Version="32.1.19" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="32.1.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PartsPortal.Contracts\PartsPortal.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CenterPointLogo_DarkText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\CenterPointLogo_LightText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\PartsPortalIcon.ico" />
  </ItemGroup>
</Project>



