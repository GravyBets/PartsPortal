<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.2.16</Version>
    <AssemblyVersion>3.2.16</AssemblyVersion>
    <FileVersion>3.2.16</FileVersion>
    <InformationalVersion>3.2.16 (Released)</InformationalVersion>
    <UseWPF>true</UseWPF>
    <NoWin32Manifest>true</NoWin32Manifest>
    <ApplicationIcon>Assets\PartsPortalIcon.ico</ApplicationIcon>
    <AssemblyName>PartsPortal</AssemblyName>
    <RootNamespace>PartsPortal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\CenterPointLogo_DarkText.png" />
    <None Remove="Assets\CenterPointLogo_LightText.png" />
    <None Remove="Assets\PartsPortalIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Licensing" Version="32.1.19" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="32.1.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PartsPortal.Contracts\PartsPortal.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CenterPointLogo_DarkText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\CenterPointLogo_LightText.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\PartsPortalIcon.ico" />
  </ItemGroup>
  <!--
    VS/MSBuild ClickOnce generates Launcher.exe for .NET applications.
    Regenerate it immediately after the stock launcher target with an explicit
    PartsPortal.exe handoff name. GenerateApplicationManifest runs afterwards,
    so ClickOnce hashes/manifests the corrected launcher.
  -->
  <Target Name="_PartsPortalRegenerateClickOnceLauncher"
          AfterTargets="_DeploymentGenerateLauncher"
          Condition="'$(GenerateClickOnceManifests)' == 'true' and '$(_DeploymentLauncherBased)' == 'true'">
    <ItemGroup>
      <_PartsPortalLauncherTarget Include="$(IntermediateOutputPath)PartsPortal.exe" />
    </ItemGroup>

    <GenerateLauncher AssemblyName="PartsPortal.exe"
                      EntryPoint="@(_PartsPortalLauncherTarget)"
                      OutputPath="$(IntermediateOutputPath)"
                      VisualStudioVersion="$(VisualStudioVersion)">
      <Output TaskParameter="OutputEntryPoint" ItemName="_PartsPortalRegeneratedLauncher" />
    </GenerateLauncher>

    <Message Importance="high"
             Text="PartsPortal: regenerated ClickOnce Launcher.exe with handoff target PartsPortal.exe." />
  </Target>

</Project>



